			EnvironmentAccess: {
				DisplayName: 配置接口
				Tooltip:
					'''
					一个用于供其他模组与魔法存储系统进行跨模组访问的元件
					显示由其他模组添加的可开关的一系列跨模组模块，如果没有模块则不显示
					可用模块:
					<MODULES>
					'''
			}

			PortableAccessPreHM: {
				DisplayName: 便携远程存储装置(基础)
				Tooltip:
					'''
					<right>存储中枢以保存定位，当前暂未定位到任何存储中枢
					使用以访问定位的存储中枢
					要使该物品能在晶塔附近使用，目标定位的存储中枢与任何有效晶塔的距离须在100格以内。
					玩家只能在距离晶塔或定位的制作接口1000格范围内访问相应的存储中枢
					访问距离较小
					'''
			}

			PortableAccessHM: {
				DisplayName: 便携远程存储装置(进阶)
