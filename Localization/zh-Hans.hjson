# I recommend using the hjson key to translate all future text additions
# Also add them into other hjsons, but mark them with "//", and wait for translators to translate the text
# -Crapsky233

Mods: {
	MagicStorage: {
		Items: {
			BiomeGlobe: {
				DisplayName: 生态球
				Tooltip:
					'''
					“世界的力量凝聚环绕在你的指尖”
					制作时算作处于水、熔岩、蜂蜜、雪原环境、灵雾、恶魔/猩红祭坛旁
					放在物品栏或制作存储单元的制作站槽位内即可生效
					放在物品栏时，不需要处在篝火旁即可将棒棒棉花糖烤熟
					可在制作单元直接用棉花糖制作熟棉花糖
					丢出去之后会像沙滩球一样弹弹弹
					'''
			}

			CraftingAccess: {
				DisplayName: 制作单元
				Tooltip: 能够使用存储系统中的物品进行制作
			}

			CreativeStorageUnit: {
				DisplayName: 创造单元
				Tooltip:
					'''
					可存储无限数量的每种物品类型
					在存储系统中不计入存储限制
					'''
			}

			Locator: {
				DisplayName: 定位器
				Tooltip:
					'''
					<right>存储核心以定位
					<right>远程存储装置以设置定位
					'''
			}

			LocatorDisk: {
				DisplayName: 定位器驱动
				Tooltip:
					'''
					<right>存储核心以定位
					<right>远程存储装置以设置定位
					可无限使用
					'''
			}

			PortableAccess: {
				DisplayName: 终极便携远程存储装置
				Tooltip:
					'''
					<right>存储核心以连接
					暂未连接到任何核心
					使用以访问相应存储核心
					无距离限制
					'''
			}

			PortableCraftingAccess: {
				DisplayName: 便携远程制作装置
				Tooltip:
					'''
					<right>制作单元以连接
					暂未连接到任何单元
					使用以访问相应制作单元
					无距离限制
					'''
			}

			RadiantJewel: {
				DisplayName: 璀璨棱晶
				Tooltip: “辐射出耀眼的光芒”
			}

			RemoteAccess: {
				DisplayName: 远程存储装置
				Tooltip:
					'''
					可远程访问某个存储核心
					对于制作单元之类的组件来说与存储核心无异
					'''
			}

			ShadowDiamond: {
				DisplayName: 暗影钻石
				Tooltip: 那道光所余留的痕迹依旧
			}

			SnowBiomeEmulator: {
				DisplayName: 破损雪花球
				Tooltip: 允许制作单元拥有雪地环境
			}

			StorageAccess: {
				DisplayName: 存储装置
				Tooltip: 可作为对存储系统中存有物品的一个访问点
			}

			StorageComponent: {
				DisplayName: 存储组件
				Tooltip: 一切魔法存储组件的合成基础材料
			}

			StorageConnector: {
				DisplayName: 存储连接器
				Tooltip: 可用于连接不同的魔法存储组件，使其并入存储网络内
			}

			StorageDeactivator: {
				DisplayName: 存储单元魔杖
				Tooltip:
					'''
					禁用/启用相应的存储单元
					被禁用的存储单元会试图将其原存有物品移动到其他启用的存储单元内
					'''
			}

			StorageHeart: {
				DisplayName: 存储核心
				Tooltip:
