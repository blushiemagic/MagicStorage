			StorageCore: {
				DisplayName: 存储核心（基础）
				Tooltip: "{$Mods.MagicStorage.Items.StorageCore.CommonTooltip}"
				CommonTooltip:
					'''
					存储原本在存储单元中的物品
					<right>空存储单元以插入
					<CAPACITY>
					<HASH>
					<BYTES>
					'''
				ItemsStored: "[c/{0}:{1} / {2} 物品]"
				Hash: 数据哈希: {0:x08}
				BytesUsed: "[c/{0}:{1} 字节]"
			}

