		NPCs: {
			Golem: {
				DisplayName: 自动机

				TownNPCMood: {
					Content: 运行中。
					NoHome: 暴露于空气，正在快速生锈，请求获得落脚点。
					LoveSpace: 已接受当前生活安排。
					FarFromHome: 本单元必须尽快回家以为蓝魔法电器充电
					DislikeCrowded: 在附近探测到太多个体。
					HateCrowded: 本单元请求独处。
					LikeBiome: "{BiomeName}与蓝魔法相容。"
					LoveBiome: "{BiomeName}与蓝魔法完美协调。"
					DislikeBiome: 已检测到{BiomeName}使得蓝魔法效率下降。
					HateBiome: 检测到处于{BiomeName}，蓝魔法已停用。
					LikeNPC: 检测到{NPCName}欣赏蓝魔法。
					LoveNPC: 附近的{NPCName}个体对本单元拥有一切操纵权.
					DislikeNPC: 本单元不屑于向{NPCName}提及蓝魔法。
					HateNPC: "{NPCName}需要改变其试图将蓝魔法用于盈利的想法"
					LikeNPC_Princess: "{NPCName}是我的创造者最好的朋友。"
					Princess_LovesNPC: "{NPCName}是如此有趣的机器，它是如何运作的？"
				}

				# Census support
