				clearSearchText: {
					Label: 自动清除搜索文本
					Tooltip: 开启后，每次打开存储核心的UI界面都会自动清除上一次键入的搜索文本
				}

				searchBarRefreshOnKey: {
					Label: 搜索结果实时更新
					Tooltip: 开启后，存储与制作面板的搜索结果将实时更新。如果关闭，则仅在搜索栏取消聚焦(即:点击面板的其他区域)时刷新搜索结果
				}

				uiFavorites: {
					Label: "[i:FallenStar]  收藏物品与配方"
					Tooltip: 开启后，可在制作单元中收藏物品和配方
				}

				extraFilterIcons: {
					Label: "[i:Cog]  更多排序选项"
					Tooltip: 开启后，在存储核心的UI界面会显示更多排序选项
				}

				buttonLayout: {
					Label: 排序/筛选按钮布局
					Tooltip: ""
				}

				itemDataDebug: {
					Label: "[i:IronPickaxe]  显示物品调试信息"
					Tooltip: 开启后，存放于存储面板的物品将显示其是否有GlobalItem数据，并允许通过按下“Print Item Data”(输出物品数据)快捷键以在聊天栏输出数据
				}

				canMovePanels: {
					Label: 流动UI面板
					Tooltip: 关闭后，UI界面将无法调节大小或进行拖动
				}

				automatonRemembers: {
					Label: 自动机记住最后一条帮助提示
					Tooltip: 自动机会记住它最后向用户显示的帮助提示，并在交互时显示该帮助提示。
				}

				enablePinyinSearch: {
					Label: 启用拼音搜索
					Tooltip: 启用后，可以通过拼音全拼或拼音首字母搜索中文物品名称
				}

				globalShimmerItemBlacklist: {
					Label: 全局物品微光黑名单
					Tooltip: 按住左 Ctrl + 左 Shift 点击以添加/移除黑名单
				}

				useOldSlotFocus: {
					Label: 使用旧版槽位焦点
					Tooltip: ""
				}
			}

			ButtonConfigurationMode: {
				// Tooltip: ""

				Legacy: {
					Label: 主界面按钮
					Tooltip:
						'''
						v0.5.6.5及以前版本的布局
						排序和筛选选项不单独分页
						'''
				}

				ModernPaged: {
					Label: 独立分页
					Tooltip: 排序和筛选按钮单独分页
				}

				ModernConfigurable: {
					Label: 自主配置
					Tooltip: 可以单独选择一些排序和筛选按钮使其出现在主界面
				}

				LegacyWithGear: {
					Label: 主界面按钮+小窗按钮
					Tooltip:
						'''
						如果关闭了“更多排序选项”则与v0.5.6.5及以前版本一致
						在主界面按钮右侧添加了一个齿轮按钮，点击后将以小窗形式显示额外的排序按钮
						排序和筛选选项不单独分页
						'''
				}

				LegacyBasicWithPaged: {
					Label: 主界面按钮+独立分页
					Tooltip:
						'''
						如果关闭了“更多排序选项”则与v0.5.6.5及以前版本一致
						额外的排序按钮独立分页
						'''
				}

				ModernDropdown: {
					Label: 下拉菜单
					Tooltip:
						'''
						在主界面添加了排序和筛选选项的下拉式菜单
						排序和筛选选项不单独分页
						'''
				}
			}

			MagicStorageServerConfig: {
				DisplayName: 魔法存储服务器配置

				allowAutomatonToMoveIn: {
					Label: 自动机入住
					Tooltip: 允许城镇NPC“自动机”入住你的城镇
				}

				auditLog: {
					Label: 服务器审计日志
					Tooltip: 启用后，客户端与任何存储系统的交互将被报告到审计日志
				}

				localHostAdmin: {
					Label: 给予本地主机服务器管理员权限
					Tooltip: 启用后，强制本地主机在加入服务器时拥有服务器管理员状态
				}

				automatonHappiness: {
					Label: 自动机快乐度影响出售价格
					Tooltip: 禁用以防止自动机影响通过物品出售模式出售的物品的出售价值
				}
			}

			// MagicStorageBetaConfig.DisplayName: "{$Mods.MagicStorage.Config.BetaLabel}"
		}
	}
}
