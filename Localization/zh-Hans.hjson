# I recommend using the hjson key to translate all future text additions
# Also add them into other hjsons, but mark them with "//", and wait for translators to translate the text
# -Crapsky233

Mods: {
	MagicStorage: {
		Items: {
			BiomeGlobe: {
				DisplayName: 生态球
				Tooltip:
					'''
					“世界的力量凝聚环绕在你的指尖”
					制作时算作处于雪原环境、灵雾环境、水、熔岩、蜂蜜、、恶魔/猩红祭坛旁
					放在物品栏或制作存储接口的制作站槽位内即可生效
					放在物品栏时，不需要处在篝火旁即可将棒棒棉花糖烤熟
					可在制作界面直接用棉花糖制作熟棉花糖
					丢出去之后会像沙滩球一样弹弹弹
					'''
			}

			制作访问权限: {
				显示名称：制作接口
				工具提示：能够使用存储系统中的物品进行制作
			}

			创意存储单元：{
				显示名称：创造单元
				提示信息：
					'''
					存储了无限量的所有物品。
					不影响存储系统的存储上限。
					'''
			}

			定位器: {
				显示名称：定位器
				提示：
					'''
					<right>存储中枢以定位
					<right>远程中枢以设置定位
					'''
			}

			LocatorDisk: {
				DisplayName: 定位器驱动
				提示：
					'''
					<right>存储中枢以定位
					<right>远程中枢以设置定位
					可无限使用
					'''
			}

			PortableAccess: {
				DisplayName: 便携远程存储装置(终极)
				Tooltip:
					'''
					<right>存储中枢以连接
					暂未连接到任何存储中枢
					使用以访问相应存储中枢
					无距离限制
					'''
			}

			PortableCraftingAccess: {
				DisplayName: 便携远程制作装置(终极)
				Tooltip:
					'''
					<right>制作接口以连接
					暂未连接到任何制作接口
					使用以访问相应制作接口
					无距离限制
					'''
			}

			RadiantJewel: {
				DisplayName: 璀璨棱晶
				Tooltip: “辐射出耀眼的光芒”
			}

			RemoteAccess: {
				DisplayName: 远程中枢
				Tooltip:
					'''
					可远程访问某个存储中枢
					对于制作接口之类的元件来说与存储中枢无异
					'''
			}

			ShadowDiamond: {
				DisplayName: 暗影钻石
				Tooltip: 那道光所余留的痕迹依旧
			}

			SnowBiomeEmulator: {
				DisplayName: 破损雪花球
				Tooltip: 允许制作接口拥有雪地环境
			}

			StorageAccess: {
				DisplayName: 存储访问器
				Tooltip: 可作为对存储系统中存有物品的一个访问点
			}

			StorageComponent: {
				DisplayName: 存储组件
				Tooltip: 一切魔法存储元件的合成基础材料
			}

			StorageConnector: {
				DisplayName: 存储连接器
				Tooltip: 可用于连接不同的魔法存储元件，使其并入存储系统内
			}

			StorageDeactivator: {
				DisplayName: 存储单元魔杖
				Tooltip:
					'''
					停用/启用相应的存储单元
					存储中枢会尝试将停用的存储单元内的物品转移到其他存储单元内
					'''
			}

			StorageHeart: {
				DisplayName: 存储中枢
				Tooltip:
					'''
					魔法存储系统的中枢
					一个存储系统需要存储中枢来运作（通过将其与存储单元相邻放置来构建一个最简单的存储系统）
					'''
			}

			StorageUnit: {
				DisplayName: 存储单元
				Tooltip:
					'''
					用于在魔法存储系统中存储物品的组件
					可存储至多 40 组物品
